# Copy to .env or export these variables in the environment before starting services.
# Do not commit the copied file.

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=replace-with-database-password

# Base64-encoded key containing at least 32 bytes for HS256 signing.
JWT_SECRET=replace-with-base64-encoded-32-byte-secret

# Shared only by trusted service-to-service calls involving the wallet service.
WALLET_INTERNAL_TOKEN=replace-with-random-internal-token

# Optional service URL overrides; local defaults are used when omitted.
USER_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
WALLET_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
BID_SERVICE_URL=http://localhost:8085
BID_WEBSOCKET_URL=ws://localhost:8085
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
